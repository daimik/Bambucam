# Copy this file to .env and edit. Compose reads .env for both the
# ${BAMBU_PORT} port mapping and the values passed into the container.

# Required for real-printer mode (not needed if BAMBU_FAKE=1):
BAMBU_IP=192.168.0.200
BAMBU_DEVICE=0123456789ABCDE
BAMBU_PASSCODE=12345678

# Port to serve the stream on (host:container, same value).
BAMBU_PORT=8080

# HTTP = browser MJPEG (default). RTP = VLC; requires host networking (see README).
SERVER=HTTP

# Set to 1 to serve a synthetic RGB test pattern with no printer.
# Leave blank for real-printer mode.
BAMBU_FAKE=
